# Copy to .env and fill in. .env is git-ignored; never commit credentials.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TYN
# Model provider: anthropic (default), gemini, groq, openrouter, ollama, custom
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# For LLM_PROVIDER=custom: any OpenAI-compatible endpoint
# LLM_BASE_URL=
# LLM_API_KEY=
# Model id (default claude-opus-5-5 for anthropic; required for other providers)
# AGENT_MODEL=
